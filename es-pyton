def stampa_riga(N):
    if N == 0:
        return
    if N % 2 == 0:
        # Se N è pari, stampiamo N seguito da N *
        print(f"{N} " + "*" * N)
    else:
        # Se N è dispari, stampiamo N seguito da N #
        print(f"{N} " + "#" * N)

def main():
    while True:
        N = int(input("Inserisci un numero intero non negativo: "))
        if N == 0:
            break
        stampa_riga(N)

if __name__ == "__main__":
    main()
